# Add these in Vercel > Project > Settings > Environment Variables
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase > Project Settings > API: the publishable key (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=
# A long password you choose, for door staff. Must match the door key saved in Supabase (see README).
DOOR_KEY=
